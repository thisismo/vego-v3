#!/bin/sh
#
# Workflow 4 — Post-Commit Synchronization Hook.
#
# Runs the local `indexer` CLI to incrementally re-index exactly the specification Markdown this
# commit touched, keeping the local RAG index (docs/.index/rag-index.json) in sync with what was
# *actually* committed. It runs entirely locally — no server is involved. It never blocks the commit
# and never fails it: it runs in the background, discards all output, and always exits 0.
#
# Install:  cp scripts/git-hooks/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit
# Override the indexer launcher with VEGO_INDEXER_CMD if it lives elsewhere.

REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
COMMIT="$(git rev-parse HEAD 2>/dev/null)" || exit 0
CMD="${VEGO_INDEXER_CMD:-$REPO/run-indexer.sh}"

(
  "$CMD" "$REPO" "$COMMIT" >/dev/null 2>&1
) &

exit 0
